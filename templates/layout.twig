{% import '_macros.twig' as macros %}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>{{ get_parameter('kernel.environment') == 'test' ? '[TEST] ' }}{% block title %}{{ pageTitle|default('Shelfpico Warehouse') }}{% endblock %}</title>
    <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
    <meta name="description" content="Shelfpico Warehouse"/>

    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#ffffff">
    <link rel="manifest" href="/manifest.json">

    <link href="/icon-32.png" type="image/x-icon" rel="shortcut icon"/>
    <link href="/icon-32.png" type="image/x-icon" rel="icon"/>

    {{ encore_entry_link_tags('lib') }}
    {{ encore_entry_link_tags('app') }}

    {% block extra_css %}{% endblock %}

    {% set route = app.request.attributes.get('_route') %}
    {% set routeParams = app.request.attributes.get('_route_params') %}
</head>
<body class="{% block body_class %}{% endblock %}">
    <div id="shelfpico-app">
        {% include "topmenu.twig" %}
        <div class="clear"></div>
        <div id="content" class="container-fluid">
            {% block content %}
                {{ macros.alerts() }}
            {% endblock %}

            <div class="spacer-10"></div>
        </div>

        <products-cover></products-cover>
    </div>

    {{ encore_entry_script_tags('lib') }}

    {% block extra_js %}{% endblock %}

    {{ encore_entry_script_tags('app') }}
</body>
</html>
