{% import '_macros.twig' as macros %}
{% extends "layout.twig" %}

{% block title %}{{ title|default('Customers') }}{% endblock %}

{% block content %}
    <h1>
        {{ title|default('Customers') }}
        <span class="badge bg-secondary">{{ customers|length }}</span>
        <a class="btn btn-success btn-sm" href="{{ path('customers.add') }}" title="Add">
            <span class="fas fa-plus"></span>
        </a>
    </h1>

    <table class="std-table" style="width: auto;">
        <tr>
            <th style="width: 20px;">ID</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Shipment</th>
            <th>Orders</th>
            <th>Deposit</th>
            <th>Debt</th>
            <th>Spent</th>
            <th>Profit</th>
        </tr>
        {% for customer in customers %}
            <tr>
                <td>{{ customer.id }}</td>
                <td>
                    <a href="{{ path('customers.edit', {id: customer.id}) }}"
                       title="Edit customer"
                    >
                        {{ customer.name }}
                    </a>
                </td>
                <td>{{ customer.phone }}</td>
                <td>{{ customer.shipmentInfo }}</td>
                <td>
                    <a href="{{ path('orders.customer', {id: customer.id}) }}"
                       title="Orders"
                    >
                        {{ profitStats[customer.id].ordersCount }}
                    </a>
                </td>
                <td>
                    {% if customer.deposit %}
                        <span class="badge bg-success">{{ customer.deposit }}</span>
                    {% endif %}
                </td>
                <td>
                    {% if customer.debt %}
                        <span class="badge bg-danger">{{ customer.debt }}</span>
                    {% endif %}
                </td>
                <td>
                    <a href="{{ path('orders.customer', {id: customer.id}) }}"
                       title="Orders"
                    >
                        {{ (profitStats[customer.id].spent ?? 0)|format_price }}
                    </a>
                </td>
                <td>
                    <a href="{{ path('orders.customer', {id: customer.id}) }}"
                       title="Orders"
                    >
                        {{ (profitStats[customer.id].profit ?? 0)|format_price }}
                    </a>
                </td>
            </tr>
        {% endfor %}
    </table>
{% endblock %}
