{% if orders is not empty %}
<table class="std-table">
    <tr>
        <th style="width: 20px;">ID</th>
        <th>Date</th>
        {% if showCustomer %}
        <th>Customer</th>
        {% endif %}
        <th>Product</th>
        <th>Links</th>
        <th class="text-nowrap">Price</th>
        <th class="text-nowrap">Amount</th>
        <th class="text-nowrap">Profit</th>
        <th>Flags</th>
        <th>Note</th>
    </tr>
    {% set totalQty = 0 %}
    {% set totalAmount = 0 %}
    {% set totalProfit = 0 %}
    {% for order in orders %}
        {% set totalQty = totalQty + order.quantity %}
        {% set totalAmount = totalAmount + order.amount %}
        {% set totalProfit = totalProfit + order.profit %}
        <tr>
            <td>
                <a href="{{ path('orders.edit', {id: order.id}) }}" target="_blank">
                    {{ order.id }}
                </a>
            </td>
            <td class="text-nowrap">
                <a href="{{ path('orders.edit', {id: order.id}) }}" target="_blank">
                    {{ order.createdAt|date('Y-m-d H:i') }}
                </a>
            </td>
            {% if showCustomer %}
            <td class="text-nowrap">
                <a href="{{ path('customers.edit', {id: order.customer.id}) }}"
                   title="Edit customer"
                >
                    {{ order.customer.name }}
                </a>
            </td>
            {% endif %}
            <td>
                {{ order.quantity }}x&nbsp;
                <a href="{{ path('products.edit', {id: order.product.id}) }}"
                   title="Edit product"
                >
                    {{ order.product.title }}
                </a>
            </td>
            <td class="text-nowrap">
                {% if order.product.url %}
                    <a class="btn p-0" href="{{ order.product.url }}" target="_blank" title="{{ order.product.url }}">
                        <span class="fa fa-link"></span>
                    </a>
                {% endif %}
                {% if order.product.atomicUrl %}
                    <a class="btn p-0" href="{{ order.product.atomicUrl }}" target="_blank" title="{{ order.product.atomicUrl }}">
                        <span class="fa fa-cube"></span>
                    </a>
                {% endif %}
            </td>
            <td class="text-right text-nowrap">{{ order.price | format_price }}</td>
            <td class="text-right text-nowrap">{{ order.amount | format_price }}</td>
            <td class="text-right text-nowrap">{{ order.profit | format_price }}</td>
            <td>
                <span class="fas fa-dollar-sign {{ order.paid ? 'color-green' : 'color-red'}}"></span>
                <span class="fas fa-truck {{ order.shipped ? 'color-green' : 'color-red'}}"></span>
            </td>
            <td>
                {% if order.url %}
                    <a href="{{ order.url }}" target="_blank">
                        {{ order.note }}
                    </a>
                {% else %}
                    {{ order.note }}
                {% endif %}
            </td>
        </tr>
    {% endfor %}
    {% if showTotal|default %}
    <tr>
        <td colspan="5">Total</td>
        <td>{{ totalQty }}</td>
        <td></td>
        <td></td>
        <td>{{ totalAmount | format_price }}</td>
        <td>{{ totalProfit | format_price }}</td>
        <td></td>
    </tr>
    {% endif %}
</table>
{% endif %}
