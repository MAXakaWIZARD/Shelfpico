<table class="std-table" style="width: auto;">
    <tr>
        <th>Date</th>
        <th>Customer</th>
        <th>Phone</th>
        <th>Shipment</th>
        <th colspan="5">Order</th>
        <th class="w80">Amount</th>
        {% if showProfit|default %}
        <th class="w80">Profit</th>
        {% endif %}
        <th>Flags</th>
        <th>Receipt</th>
    </tr>
    {% for key, item in data %}
    <tr>
        <td>
            {{ item.orders[0].createdAt|date('Y-m-d') }}
        </td>
        <td>
            <a href="{{ path('customers.edit', {id: item.customer.id}) }}"
               title="Edit customer"
               target="_blank"
            >
                {{ item.customer.name }}
            </a>
        </td>
        <td>{{ item.customer.phone }}</td>
        <td class="w150">
            {{ item.customer.shipmentInfo }}
        </td>
        <td>
        {% for order in item.orders %}
            <a href="{{ path('orders.edit', {id: order.id}) }}"
               title="Edit order #{{ order.id }}"
               target="_blank"
            >
                #{{ order.id }}
            </a>
            <br/>
        {% endfor %}
        </td>
        <td>
        {% for order in item.orders %}
            <a href="{{ path('orders.edit', {id: order.id}) }}"
               title="Edit order #{{ order.id }}"
               target="_blank"
            >
                {{ order.quantity }}x
            </a>
            <br/>
        {% endfor %}
        </td>
        <td class="text-right">
        {% for order in item.orders %}
            <a href="{{ path('orders.edit', {id: order.id}) }}"
               title="Edit order #{{ order.id }}"
               target="_blank"
            >
                {{ order.price | format_price }}
            </a>
            <br/>
        {% endfor %}
        </td>
        <td>
        {% for order in item.orders %}
            <a href="{{ path('products.edit', {id: order.product.id}) }}"
               title="Edit product"
               target="_blank"
            >
                {{ order.product.isTuningPart ? '' : order.product.sku ~ ' ' }}
                {{ order.receiptTitle }}
            </a>

            = {{ order.amount | format_price }}
            <br/>
        {% endfor %}
        </td>
        <td class="w50 px-0">
        {% for order in item.orders %}
            {% if not order.paid %}
                <span title="Not paid" class="fas fa-dollar-sign color-red"></span>
            {% endif %}
            {% if not order.shipped %}
                <span title="Not shipped" class="fas fa-truck color-red"></span>
            {% endif %}
            <br/>
        {% endfor %}
        </td>
        <td class="text-right">
            {{ item.totalAmount | format_price }}
            {% if item.totalPaid > 0 and item.totalPaid < item.totalAmount %}
                <br/><span class="color-green">{{ item.totalPaid | format_price }}</span>
            {% endif %}
            {% if item.totalDue > 0 %}
                <br/><span class="color-red">{{ item.totalDue | format_price }}</span>
            {% endif %}
        </td>
        {% if showProfit|default %}
        <td>{{ item.totalProfit | format_price }}</td>
        {% endif %}
        <td>
            <a href="{{ path('orders.mark-paid', {key: key}) }}"
               title="Mark all as paid"
            >
                <span class="fas fa-dollar-sign {{ item.paid ? 'color-green' : 'color-red'}}"></span>
            </a>
            <a href="{{ path('orders.mark-shipped', {key: key}) }}"
               title="Mark all as shipped"
            >
                <span class="fas fa-truck {{ item.shipped ? 'color-green' : 'color-red'}}"></span>
            </a>
        </td>
        <td>
            <a href="{{ path('orders.receipt', {key: key, lang: 'UA'}) }}"
               target="_blank"
            >
                UA
            </a>
            &nbsp;
            <a href="{{ path('orders.receipt', {key: key, lang: 'EN'}) }}"
               target="_blank"
            >
                EN
            </a>
        </td>
    </tr>
    {% endfor %}
</table>
