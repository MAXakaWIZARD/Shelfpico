<table class="std-table" style="width: 100%;">
<tr>
    <td colspan="3" class="text-center">
        <img src="images/logo.jpg" height="70" alt="">
    </td>
</tr>
<tr>
    <td class="text-center" colspan="3">
         <span class="badge bg-secondary f14">
            {{ get_parameter('database_name') }}
        </span>
        <span class="badge bg-primary f14 ml-5">
            {{ currentDbVersion }}
        </span>
    </td>
</tr>
<tr>
    <td class="bold">Profit curr/pot</td>
    <td class="text-right">{{ totalProfit|format_price }}</td>
    <td class="text-right">{{ (inStockSalePrice - inStockBuyPrice)|format_price }}</td>
</tr>
<tr>
    <td>Stock buy/sale</td>
    <td class="text-right">{{ inStockBuyPrice|format_price }}</td>
    <td class="text-right">{{ inStockSalePrice|format_price }}</td>
</tr>
<tr>
    <td>Total restocks</td>
    <td class="text-right" colspan="2">{{ totalSpentAmount|format_price }}</td>
</tr>
<tr>
    <td>Total orders</td>
    <td class="text-right" colspan="2">{{ totalReceivedAmount|format_price }}</td>
</tr>
</table>

<div class="card mt-10 mb-0">
    <div class="card-header c-pointer" v-panel-toggle>
        <span class="fas fa-tags"></span>
        Tags
        <span class="fas fa-chevron-down float-end panel-toggle-icon"></span>
    </div>
    <div class="card-body d-none py-5"
         data-content-url="{{ path('dashboard.tags-stats') }}"
    >
    </div>
</div>
