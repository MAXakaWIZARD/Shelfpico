<?xml version="1.0"?>
<ruleset name="Shelfpico Coding Standard">
    <arg name="basepath" value="."/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    
    <!-- Show progress -->
    <arg value="p"/>
    
    <!-- Show sniff codes in all reports -->
    <arg value="s"/>
    
    <rule ref="PHPCompatibility"/>
    <!-- Check for cross-version support for PHP 8.1 and higher -->
    <config name="testVersion" value="8.5-"/>

    <!-- Use PSR-12 as base -->
    <rule ref="PSR12"/>

    <!-- Paths to check -->
    <file>src</file>

    <!-- Ignore migrations line length (they contain long SQL statements) -->
    <rule ref="Generic.Files.LineLength.TooLong">
        <exclude-pattern>*/Migrations/*</exclude-pattern>
    </rule>
    
    <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace.EndLine">
        <severity>0</severity>
    </rule>
</ruleset>

