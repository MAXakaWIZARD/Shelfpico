# Copy this file to .env.local and fill in your actual values

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=your-secret-key-here
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Database configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=shelfpico
DATABASE_USER=your-db-user
DATABASE_PASSWORD=your-db-password
DATABASE_SERVER_VERSION="10.4.21-MariaDB"
###< doctrine/doctrine-bundle ###

# Binary paths (adjust for your system)
BIN_MYSQLDUMP="/Applications/XAMPP/xamppfiles/bin/mysqldump"
BIN_MYSQL="/Applications/XAMPP/xamppfiles/bin/mysql"
BIN_GZIP="/usr/bin/gzip"
BIN_PHP="/Applications/XAMPP/xamppfiles/bin/php"

# Local paths
PATH_BACKUP="/Users/user1/shelfpico"
